<div class="sidebar">
    <div class="sidebar-logo">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: #FCD34D;"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
        FlowDesk
    </div>
    <nav class="sidebar-nav">
        <ul>
            <li>
                <a href="/dashboard" class="sidebar-nav-item <%= typeof currentPath !== 'undefined' && currentPath === '/dashboard' ? 'active' : '' %>">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="9"></rect><rect x="14" y="3" width="7" height="5"></rect><rect x="14" y="12" width="7" height="9"></rect><rect x="3" y="16" width="7" height="5"></rect></svg>
                    Dashboard
                </a>
            </li>
            <li>
                <a href="/tasks" class="sidebar-nav-item <%= typeof currentPath !== 'undefined' && currentPath === '/tasks' ? 'active' : '' %>">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 11 12 14 22 4"></polyline><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path></svg>
                    Tasks
                </a>
            </li>
            <li>
                <a href="/projects" class="sidebar-nav-item <%= typeof currentPath !== 'undefined' && currentPath.startsWith('/projects') ? 'active' : '' %>">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path></svg>
                    Projects
                </a>
            </li>
            <li>
                <a href="/team" class="sidebar-nav-item <%= typeof currentPath !== 'undefined' && currentPath === '/team' ? 'active' : '' %>">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                    Team
                </a>
            </li>
        </ul>
    </nav>
    <div style="padding: 24px; border-top: 1px solid rgba(255,255,255,0.1);">
        <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 12px;">
            <div class="avatar" style="background: rgba(255,255,255,0.1); color: #FFF;">
                <%= typeof user !== 'undefined' && user && user.name ? user.name.charAt(0) : 'U' %>
            </div>
            <div>
                <div style="font-size: 14px; font-weight: bold;"><%= typeof user !== 'undefined' && user ? user.name : 'User' %></div>
                <div class="badge badge-primary" style="font-size: 10px; margin-top: 4px; border: 1px solid var(--primary);"><%= typeof user !== 'undefined' && user ? user.role : 'Member' %></div>
            </div>
        </div>
        <a href="/auth/logout" style="color: #F87171; font-size: 14px; text-decoration: none; display: flex; align-items: center; gap: 8px; margin-top: 16px;">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
            Logout
        </a>
    </div>
</div>
