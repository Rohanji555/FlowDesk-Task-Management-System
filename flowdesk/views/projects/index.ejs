<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Projects | FlowDesk</title>
    <link rel="stylesheet" href="/css/style.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>body { font-family: 'Inter', sans-serif; }</style>
</head>
<body class="<%= typeof theme !== 'undefined' && theme === 'dark' ? 'dark-mode' : '' %>" data-project-id="<%= typeof project !== 'undefined' && project ? project._id : '' %>" data-task-id="<%= typeof task !== 'undefined' && task ? task._id : '' %>" data-user-id="<%= typeof user !== 'undefined' && user ? user._id : '' %>">
<%
  const sidebarLinks = [
    { href: '/dashboard', label: 'Dashboard', icon: 'grid' },
    { href: '/tasks', label: 'Tasks', icon: 'check-square' },
    { href: '/projects', label: 'Projects', icon: 'folder' }
  ]
%>
    <div class="app-layout">
        <%- include('../layouts/sidebar', { sidebarLinks, user, currentPath: typeof currentPath !== 'undefined' ? currentPath : '/' }) %>
        <div class="main-content">
            <%- include('../layouts/topbar', { title: typeof pageTitle !== 'undefined' ? pageTitle : 'FlowDesk', user }) %>
            <%- include('../partials/flash') %>

            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 32px;">
                <h2 style="font-size: 24px;">Projects</h2>
                <% if (user && user.role !== 'employee') { %>
                    <a href="/projects/new" class="btn btn-primary">+ New Project</a>
                <% } %>
            </div>

            <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px;">
                <% if (typeof projects !== 'undefined' && projects.length > 0) { %>
                    <% projects.forEach(project => { %>
                        <a href="/projects/<%= project._id %>" style="display: block; text-decoration: none; color: inherit; background: var(--card-bg); border-radius: var(--radius); box-shadow: var(--shadow); border-top: 4px solid <%= project.color || 'var(--primary)' %>; padding: 24px; transition: transform 0.2s, box-shadow 0.2s;" onmouseover="this.style.transform='translateY(-4px)'; this.style.boxShadow='0 10px 25px rgba(0,0,0,0.1)';" onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='var(--shadow)';">
                            
                            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 12px;">
                                <h3 style="font-size: 18px; margin: 0; color: var(--text-primary);"><%= project.name %></h3>
                                <div class="badge badge-<%= project.status === 'completed' ? 'success' : (project.status === 'active' ? 'primary' : 'warning') %>"><%= project.status || 'active' %></div>
                            </div>
                            
                            <p style="color: var(--text-secondary); font-size: 14px; margin-bottom: 24px; line-height: 1.5; min-height: 42px;">
                                <%= project.description ? (project.description.length > 100 ? project.description.substring(0, 100) + '...' : project.description) : 'No description provided.' %>
                            </p>
                            
                            <div style="margin-bottom: 24px;">
                                <div style="display: flex; justify-content: space-between; font-size: 12px; color: var(--text-muted); margin-bottom: 8px;">
                                    <span>Progress</span>
                                    <span>0%</span>
                                </div>
                                <div style="height: 6px; background: var(--border); border-radius: 3px; overflow: hidden;">
                                    <div style="width: 0%; height: 100%; background: <%= project.color || 'var(--primary)' %>;"></div>
                                </div>
                            </div>
                            
                            <div style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid var(--border); padding-top: 16px;">
                                <div style="display: flex; align-items: center;">
                                    <% if (project.members && project.members.length > 0) { %>
                                        <% project.members.slice(0, 4).forEach((member, index) => { %>
                                            <div class="avatar" style="width: 28px; height: 28px; font-size: 10px; border: 2px solid var(--card-bg); margin-left: <%= index === 0 ? '0' : '-8px' %>;" title="<%= member.user ? member.user.name : 'Unknown' %>">
                                                <%= member.user ? member.user.name.charAt(0) : 'U' %>
                                            </div>
                                        <% }) %>
                                        <% if (project.members.length > 4) { %>
                                            <div class="avatar" style="width: 28px; height: 28px; font-size: 10px; border: 2px solid var(--card-bg); margin-left: -8px; background: var(--border); color: var(--text-muted);">
                                                +<%= project.members.length - 4 %>
                                            </div>
                                        <% } %>
                                    <% } else { %>
                                        <span style="font-size: 12px; color: var(--text-muted);">No members</span>
                                    <% } %>
                                </div>
                                
                                <div style="font-size: 12px; color: var(--text-secondary); display: flex; align-items: center; gap: 4px;">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                                    <%= project.deadline ? new Date(project.deadline).toLocaleDateString() : 'No deadline' %>
                                </div>
                            </div>
                        </a>
                    <% }) %>
                <% } else { %>
                    <div style="grid-column: 1 / -1; padding: 48px; text-align: center; background: var(--card-bg); border-radius: var(--radius); border: 1px dashed var(--border); color: var(--text-muted);">
                        No projects found.
                    </div>
                <% } %>
            </div>
        </div>
    </div>
    
    <script src="https://cdn.socket.io/4.5.4/socket.io.min.js"></script>
    <script src="/js/socket-client.js"></script>
    <script src="/js/main.js"></script>
</body>
</html>
