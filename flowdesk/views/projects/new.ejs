<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>New Project | FlowDesk</title>
    <link rel="stylesheet" href="/css/style.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>body { font-family: 'Inter', sans-serif; }</style>
</head>
<body class="<%= typeof theme !== 'undefined' && theme === 'dark' ? 'dark-mode' : '' %>" data-project-id="<%= typeof project !== 'undefined' && project ? project._id : '' %>" data-task-id="<%= typeof task !== 'undefined' && task ? task._id : '' %>" data-user-id="<%= typeof user !== 'undefined' && user ? user._id : '' %>">
<%
  const sidebarLinks = [
    { href: '/dashboard', label: 'Dashboard', icon: 'grid' },
    { href: '/tasks', label: 'Tasks', icon: 'check-square' },
    { href: '/projects', label: 'Projects', icon: 'folder' }
  ]
%>
    <div class="app-layout">
        <%- include('../layouts/sidebar', { sidebarLinks, user, currentPath: typeof currentPath !== 'undefined' ? currentPath : '/' }) %>
        <div class="main-content">
            <%- include('../layouts/topbar', { title: typeof pageTitle !== 'undefined' ? pageTitle : 'FlowDesk', user }) %>
            <%- include('../partials/flash') %>

            <div style="max-width: 600px; margin: 0 auto;">
                <h2 style="margin-bottom: 24px;">Create New Project</h2>
                
                <div style="background: var(--card-bg); padding: 32px; border-radius: var(--radius); box-shadow: var(--shadow);">
                    <form action="/projects" method="POST" class="standard-form">
                        <div class="form-group">
                            <label for="name">Project Name</label>
                            <input type="text" id="name" name="name" required class="form-control" placeholder="e.g., Marketing Website Redesign">
                        </div>
                        
                        <div class="form-group">
                            <label for="description">Description</label>
                            <textarea id="description" name="description" rows="5" class="form-control" placeholder="What is this project about?"></textarea>
                        </div>

                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
                            <div class="form-group">
                                <label for="color">Theme Color</label>
                                <div style="display: flex; gap: 12px; align-items: center;">
                                    <input type="color" id="color" name="color" value="#4F46E5" style="width: 40px; height: 40px; padding: 0; border: none; border-radius: 4px; cursor: pointer;">
                                    <span style="font-size: 14px; color: var(--text-muted);">Select a color to identify this project</span>
                                </div>
                            </div>
                            
                            <div class="form-group">
                                <label for="deadline">Deadline</label>
                                <input type="date" id="deadline" name="deadline" class="form-control">
                            </div>
                        </div>
                        
                        <div style="display: flex; gap: 16px; margin-top: 32px;">
                            <button type="submit" class="btn btn-primary">Create Project</button>
                            <a href="/projects" class="btn btn-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
    
    <script src="https://cdn.socket.io/4.5.4/socket.io.min.js"></script>
    <script src="/js/socket-client.js"></script>
    <script src="/js/main.js"></script>
</body>
</html>
