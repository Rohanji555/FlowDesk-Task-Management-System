<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Forgot Password | FlowDesk</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="auth-page">
    <div class="auth-card">
        <div style="text-align: center; margin-bottom: 24px;">
            <h2>⚡ FlowDesk</h2>
            <p style="color: var(--text-muted);">Reset your password</p>
        </div>
        
        <% if (typeof success !== 'undefined' && success && success.length) { %>
            <div style="background: rgba(5,150,105,0.1); border-left: 4px solid var(--secondary); padding: 12px; margin-bottom: 16px; border-radius: 4px; color: var(--secondary); font-size: 14px;">
                <%= success %>
            </div>
        <% } %>

        <form action="/auth/forgot-password" method="POST" class="standard-form">
            <div class="form-group">
                <label for="email">Email Address</label>
                <input type="email" id="email" name="email" required class="form-control" placeholder="name@company.com">
                <small style="color: var(--text-muted); display: block; margin-top: 8px;">We will send a reset link to your email.</small>
            </div>
            
            <button type="submit" class="btn btn-primary" style="width: 100%;">Send Reset Link</button>
        </form>
        
        <div style="text-align: center; margin-top: 24px; font-size: 14px;">
            <a href="/auth/login">Back to Login</a>
        </div>
    </div>
</body>
</html>
