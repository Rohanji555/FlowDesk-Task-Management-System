<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof pageTitle !== 'undefined' ? pageTitle : 'Team' %> | FlowDesk</title>
    <link rel="stylesheet" href="/css/style.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>body { font-family: 'Inter', sans-serif; }</style>
</head>
<body class="<%= typeof theme !== 'undefined' && theme === 'dark' ? 'dark-mode' : '' %>" data-user-id="<%= typeof user !== 'undefined' && user ? user._id : '' %>">
<%
  const sidebarLinks = [
    { href: '/dashboard', label: 'Dashboard', icon: 'grid' },
    { href: '/tasks', label: 'Tasks', icon: 'check-square' },
    { href: '/projects', label: 'Projects', icon: 'folder' }
  ]
%>
    <div class="app-layout">
        <%- include('../layouts/sidebar', { sidebarLinks, user, currentPath: typeof currentPath !== 'undefined' ? currentPath : '/' }) %>
        
        <div class="main-content">
            <%- include('../layouts/topbar', { title: typeof pageTitle !== 'undefined' ? pageTitle : 'Team', user }) %>
            <%- include('../partials/flash') %>

<div class="team-header" style="margin-bottom: 32px; display: flex; justify-content: space-between; align-items: center;">
    <div>
        <p style="color: var(--text-secondary); margin-top: 8px;">Meet the people behind the magic.</p>
    </div>
</div>

<div class="team-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 24px;">
    <% if (typeof teamMembers !== 'undefined' && teamMembers.length > 0) { %>
        <% teamMembers.forEach(member => { %>
            <div class="team-card" style="background: var(--card-bg); border-radius: var(--radius); padding: 24px; box-shadow: var(--shadow); text-align: center; border-top: 4px solid var(--primary); transition: transform 0.2s;">
                <div class="avatar" style="width: 80px; height: 80px; margin: 0 auto 16px; font-size: 32px;">
                    <% if (member.avatar && member.avatar !== 'default-avatar.png') { %>
                        <img src="<%= member.avatar %>" alt="<%= member.name %>" style="width: 100%; height: 100%; border-radius: 50%; object-fit: cover;">
                    <% } else { %>
                        <%= member.name.charAt(0).toUpperCase() %>
                    <% } %>
                </div>
                <h3 style="font-size: 18px; margin-bottom: 4px; color: var(--text-primary);"><%= member.name %></h3>
                <p style="font-size: 14px; color: var(--text-secondary); margin-bottom: 12px;"><%= member.email %></p>
                
                <div style="display: flex; gap: 8px; justify-content: center; margin-top: 16px;">
                    <span class="badge badge-<%= member.role === 'admin' ? 'danger' : (member.role === 'manager' ? 'warning' : 'primary') %>" style="text-transform: capitalize;">
                        <%= member.role %>
                    </span>
                    <% if (member.department) { %>
                        <span class="badge" style="background: #E2E8F0; color: #475569;"><%= member.department %></span>
                    <% } %>
                </div>
            </div>
        <% }) %>
    <% } else { %>
        <div class="empty-state" style="grid-column: 1 / -1; background: var(--card-bg); border-radius: var(--radius); padding: 48px; text-align: center;">
            <div style="font-size: 48px; margin-bottom: 16px;">👥</div>
            <h3 style="color: var(--text-primary);">No team members found</h3>
            <p style="color: var(--text-secondary);">It looks a little lonely here.</p>
        </div>
    <% } %>
</div>

<style>
    .team-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
    }
</style>
        </div>
    </div>
    <script src="https://cdn.socket.io/4.5.4/socket.io.min.js"></script>
    <script src="/js/socket-client.js"></script>
    <script src="/js/main.js"></script>
</body>
</html>
