<% if (typeof user !== 'undefined' && user) { %>
    <div class="avatar" style="width: 32px; height: 32px; font-size: 12px;" title="<%= user.name %>">
        <%= user.name.charAt(0) %>
    </div>
<% } else { %>
    <div class="avatar" style="width: 32px; height: 32px; font-size: 12px;" title="Unknown">?</div>
<% } %>
