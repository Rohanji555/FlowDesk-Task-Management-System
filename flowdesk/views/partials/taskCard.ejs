<div class="task-card priority-<%= typeof task !== 'undefined' && task.priority ? task.priority : 'medium' %>" data-id="<%= typeof task !== 'undefined' && task._id ? task._id : '' %>" draggable="true">
    <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 12px;">
        <h4 style="font-size: 15px; margin: 0; color: var(--text-primary); line-height: 1.4;"><%= typeof task !== 'undefined' && task.title ? task.title : 'Untitled Task' %></h4>
        <div class="badge badge-<%= typeof task !== 'undefined' && task.status === 'done' ? 'success' : (task.status === 'in-progress' ? 'warning' : 'primary') %>">
            <%= typeof task !== 'undefined' && task.status ? task.status : 'todo' %>
        </div>
    </div>
    
    <div style="font-size: 12px; color: var(--text-muted); margin-bottom: 16px;">
        <%= typeof task !== 'undefined' && task.project ? task.project.name : 'No Project' %>
    </div>
    
    <div style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid var(--border); padding-top: 12px;">
        <div style="font-size: 12px; color: var(--text-secondary); display: flex; align-items: center; gap: 4px;">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
            <%= typeof task !== 'undefined' && task.dueDate ? new Date(task.dueDate).toLocaleDateString() : 'No Due Date' %>
        </div>
        
        <% if (typeof task !== 'undefined' && task.assignedTo) { %>
            <div class="avatar" style="width: 24px; height: 24px; font-size: 10px;" title="<%= task.assignedTo.name %>">
                <%= task.assignedTo.name.charAt(0) %>
            </div>
        <% } else { %>
            <div class="avatar" style="width: 24px; height: 24px; font-size: 10px;" title="Unassigned">?</div>
        <% } %>
    </div>
</div>
