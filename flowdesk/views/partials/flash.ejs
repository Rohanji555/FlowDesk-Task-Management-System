<% if (typeof success !== 'undefined' && success && success.length) { %>
  <div class="toast toast-success"><%= success %></div>
<% } %>
<% if (typeof error !== 'undefined' && error && error.length) { %>
  <div class="toast toast-error" style="border-left-color: var(--danger);"><%= error %></div>
<% } %>
