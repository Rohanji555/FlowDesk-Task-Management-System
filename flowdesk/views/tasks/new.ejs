<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>New Task | FlowDesk</title>
    <link rel="stylesheet" href="/css/style.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>body { font-family: 'Inter', sans-serif; }</style>
</head>
<body class="<%= typeof theme !== 'undefined' && theme === 'dark' ? 'dark-mode' : '' %>" data-project-id="<%= typeof project !== 'undefined' && project ? project._id : '' %>" data-task-id="<%= typeof task !== 'undefined' && task ? task._id : '' %>" data-user-id="<%= typeof user !== 'undefined' && user ? user._id : '' %>">
<%
  const sidebarLinks = [
    { href: '/dashboard', label: 'Dashboard', icon: 'grid' },
    { href: '/tasks', label: 'Tasks', icon: 'check-square' },
    { href: '/projects', label: 'Projects', icon: 'folder' }
  ]
%>
    <div class="app-layout">
        <%- include('../layouts/sidebar', { sidebarLinks, user, currentPath: typeof currentPath !== 'undefined' ? currentPath : '/' }) %>
        <div class="main-content">
            <%- include('../layouts/topbar', { title: typeof pageTitle !== 'undefined' ? pageTitle : 'FlowDesk', user }) %>
            <%- include('../partials/flash') %>

            <div style="max-width: 800px; margin: 0 auto;">
                <h2 style="margin-bottom: 24px;">Create New Task</h2>
                
                <div style="background: var(--card-bg); padding: 32px; border-radius: var(--radius); box-shadow: var(--shadow);">
                    <form action="/tasks" method="POST" class="standard-form">
                        <div class="form-group">
                            <label for="title">Task Title</label>
                            <input type="text" id="title" name="title" required class="form-control" placeholder="e.g., Update homepage banner">
                        </div>
                        
                        <div class="form-group">
                            <label for="description">Description</label>
                            <textarea id="description" name="description" rows="6" class="form-control" placeholder="Provide details about the task..."></textarea>
                        </div>
                        
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
                            <div class="form-group">
                                <label for="project">Project</label>
                                <select id="project" name="project" class="form-control">
                                    <option value="">No Project</option>
                                    <% if (typeof projects !== 'undefined') { %>
                                        <% projects.forEach(p => { %>
                                            <option value="<%= p._id %>"><%= p.name %></option>
                                        <% }) %>
                                    <% } %>
                                </select>
                            </div>
                            
                            <div class="form-group">
                                <label for="assignedTo">Assign To</label>
                                <select id="assignedTo" name="assignedTo" class="form-control">
                                    <option value="">Unassigned</option>
                                    <% if (typeof users !== 'undefined') { %>
                                        <% users.forEach(u => { %>
                                            <option value="<%= u._id %>"><%= u.name %></option>
                                        <% }) %>
                                    <% } %>
                                </select>
                            </div>
                        </div>

                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
                            <div class="form-group">
                                <label for="priority">Priority</label>
                                <select id="priority" name="priority" class="form-control">
                                    <option value="low">Low</option>
                                    <option value="medium" selected>Medium</option>
                                    <option value="high">High</option>
                                    <option value="critical">Critical</option>
                                </select>
                            </div>
                            
                            <div class="form-group">
                                <label for="dueDate">Due Date</label>
                                <input type="date" id="dueDate" name="dueDate" class="form-control">
                            </div>
                        </div>

                        <div class="form-group">
                            <label for="tags">Tags (comma separated)</label>
                            <input type="text" id="tags" name="tags" class="form-control" placeholder="frontend, bug, UI">
                            <small style="color: var(--text-muted); display: block; margin-top: 4px;">Separate tags with commas</small>
                        </div>
                        
                        <div style="display: flex; gap: 16px; margin-top: 32px;">
                            <button type="submit" class="btn btn-primary">Create Task</button>
                            <a href="/tasks" class="btn btn-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
    
    <script src="https://cdn.socket.io/4.5.4/socket.io.min.js"></script>
    <script src="/js/socket-client.js"></script>
    <script src="/js/main.js"></script>
</body>
</html>
